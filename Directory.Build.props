<Project>
  <!-- La versione sta solo qui. Si alza di 0.0.1 e si scrive la voce nel CHANGELOG:
       la CI la legge da questo file e pubblica la release da sola. -->
  <PropertyGroup>
    <Version>2.3.0</Version>
    <Authors>DaProd</Authors>
    <Company>DaProdProduzioni</Company>
    <Product>DaP Convertitore</Product>
    <Copyright>DaProdProduzioni</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- L'app di Windows resta su questo framework. Il motore, su Linux, aggiunge anche net10.0
         e qui non si sovrascrive un TargetFramework già scelto (la compilazione per ogni piattaforma). -->
    <TargetFramework Condition="'$(TargetFramework)' == '' and '$(TargetFrameworks)' == ''">net10.0-windows10.0.22621.0</TargetFramework>
    <!-- Su una macchina Linux si può comunque compilare il progetto Windows del motore (non si esegue). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
