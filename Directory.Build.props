<Project>
  <!-- La versione sta solo qui. Si alza di 0.0.1 e si scrive la voce nel CHANGELOG:
       la CI la legge da questo file e pubblica la release da sola. -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <Authors>DaProd</Authors>
    <Company>DaProdProduzioni</Company>
    <Product>DaP Convertitore</Product>
    <Copyright>DaProdProduzioni</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
